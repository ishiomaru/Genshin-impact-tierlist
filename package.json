{
  "name": "teyvat-dps-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data": "python3 scripts/prepare-data.py",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/model.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:edges": "node tests/edge-cases.mjs",
    "format": "prettier --write src scripts tests index.html package.json tsconfig.json"
  },
  "dependencies": {
    "marked": "17.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
